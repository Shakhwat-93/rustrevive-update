# ==============================================================================
# RUST & REVIVE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT: Never commit actual production secrets or private keys to Git.
#
# Scope Key:
# [PUBLIC] = Exposed to browser client (Prefix with NEXT_PUBLIC_)
# [SERVER] = Server-only runtime secret (Never exposed to browser)
# [INFRA]  = Docker / VPS infrastructure secret
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE & HOSTING [SERVER]
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME="0.0.0.0"
NEXT_TELEMETRY_DISABLED=1
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE & AUTH [PUBLIC & SERVER]
# ------------------------------------------------------------------------------
# [PUBLIC] Base URL to Supabase Kong Gateway
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# [PUBLIC] Anon / Publishable Key (Protected by PostgreSQL Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# [SERVER] Service Role Key (BYPASSES ALL RLS - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# [INFRA] Supabase Database Connection Details
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@localhost:5432/postgres

# [INFRA] Supabase Auth Secrets
JWT_SECRET=your_super_secret_jwt_secret_min_32_chars_long
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_URI_ALLOW_LIST=http://localhost:3000/auth/callback,https://rustrevive.store/auth/callback

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 MEDIA STORAGE [SERVER & PUBLIC]
# ------------------------------------------------------------------------------
# [SERVER] Cloudflare Account ID & R2 Endpoint
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key_here
R2_BUCKET_NAME=rustrevive-media-prod
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# [PUBLIC] CDN Public Custom Domain for Image Serving
NEXT_PUBLIC_MEDIA_URL=https://media.rustrevive.store

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (STRIPE) [SERVER & PUBLIC]
# ------------------------------------------------------------------------------
# [PUBLIC] Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# [SERVER] Stripe Secret Key (NEVER EXPOSE TO BROWSER)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# [SERVER] Stripe Webhook Signing Secret (For Idempotent Verification)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 5. BACKUP & SYSTEM MAINTENANCE [INFRA / SERVER]
# ------------------------------------------------------------------------------
BACKUP_PASSPHRASE=your_aes256_gpg_backup_encryption_passphrase_here
R2_BACKUP_BUCKET_NAME=rustrevive-db-backups
